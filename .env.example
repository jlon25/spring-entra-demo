# Host-side ports.
API_PORT=8080
IDENTITY_PORT=9000
# Keep loopback unless API access from a trusted network is explicitly needed.
# For LAN access, prefer the VM's specific private IP and restrict the firewall.
API_BIND_ADDRESS=127.0.0.1

# Development-only login. Set your own local password (at least 12 characters).
# Never commit .env or reuse a real account password. No password default is provided.
DEV_IDENTITY_USERNAME=local-user
DEV_IDENTITY_PASSWORD=

# Optional PostgreSQL integration: used only with compose.postgres.yaml.
# Bootstrap administrator, never the application's database account.
# These values initialize an EMPTY volume only; changing them does not rotate
# credentials or rename a database in an existing cluster.
POSTGRES_DB=auditions
POSTGRES_USER=postgres
# Set a separate local password before opting in. Never commit the real .env.
POSTGRES_PASSWORD=

# Required only with the PostgreSQL override. Choose two different local secrets,
# distinct from POSTGRES_PASSWORD and the simulated-login/SSH passwords.
# Start postgres, then run bash dev/postgres_prepare.sh before starting the API.
# Re-running prepare explicitly updates these two role passwords on existing volumes.
APP_DB_PASSWORD=
DB_MIGRATION_PASSWORD=
